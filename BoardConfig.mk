# Architecture (Exynos 7870 코어 스펙에 맞춘 arm64 설정)
TARGET_ARCH := arm64
TARGET_ARCH_VARIANT := armv8-a
TARGET_CPU_ABI := arm64-v8a
TARGET_CPU_ABI2 := armeabi-v7a
TARGET_CPU_VARIANT := generic

# Bootloader
BOARD_VENDOR := samsung
TARGET_BOOTLOADER_BOARD_NAME := universal7870
BOARD_KERNEL_CMDLINE := androidboot.hardware=gtaxladwifikx

# Kernel
BOARD_KERNEL_BASE := 0x80008000
BOARD_KERNEL_PAGESIZE := 2048
BOARD_KERNEL_TAGS_OFFSET := 0x00000100

# Ramdisk
BOARD_RAMDISK_OFFSET := 0x00008000
BOARD_RAMDISK_SIZE := 33554432

# Boot Image
BOARD_BOOTIMAGE_SIZE := 33554432
BOARD_MKBOOTIMG_ARGS := --kernel_offset 0x00008000 --ramdisk_offset 0x01000000 --tags_offset 0x00000100

# Storage / Partitioning (실측 mmcblk0p11 크기 반영)
BOARD_FLASH_BLOCK_SIZE := 131072
BOARD_RECOVERYIMAGE_PARTITION_SIZE := 39845888
BOARD_USES_NAND := false

# Graphics & Display (실측 1200x1920, 레거시 프레임버퍼 제거 및 RGBA 포맷 조정)
BOARD_RECOVERY_SCREEN_WIDTH := 1200
BOARD_RECOVERY_SCREEN_HEIGHT := 1920
TARGET_RECOVERY_PIXEL_FORMAT := "RGBA_8888"

# TWRP Configuration & UI Rendering (백라이트 제어 설정)
TW_THEME := portrait_hdpi
TW_SCREEN_BLANK_ON_BOOT := true
TW_BRIGHTNESS_PATH := "/sys/class/backlight/panel/brightness"
TW_MAX_BRIGHTNESS := 306
TW_DEFAULT_BRIGHTNESS := 180

# Hardware Exclusions
BOARD_HAS_MTK_HARDWARE := false
# ===== Backlight =====
TW_BRIGHTNESS_PATH := "/sys/class/backlight/panel/brightness"
TW_MAX_BRIGHTNESS := 255
TW_DEFAULT_BRIGHTNESS := 255
TW_NO_SCREEN_BLANK := true
TW_NO_SCREEN_TIMEOUT := true

# ===== Graphics (1200x1920) =====
TARGET_SCREEN_WIDTH := 1200
TARGET_SCREEN_HEIGHT := 1920
TARGET_RECOVERY_PIXEL_FORMAT := "RGBX_8888"
RECOVERY_GRAPHICS_USE_LINELENGTH := true

# ===== TWRP =====
TW_THEME := portrait_hdpi
TW_NO_REBOOT_BOOTLOADER := true
TW_HAS_DOWNLOAD_MODE := true
